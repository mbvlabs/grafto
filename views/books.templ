package views

import (
	"github.com/mbvlabs/grafto/models"
	"github.com/mbvlabs/grafto/views/internal/layouts"
	"github.com/mbvlabs/grafto/views/internal/components"
)

type Book struct {
	models models.Book
}

templ (r Book) Index() {
	@layouts.Base() {
		<div class="container mx-auto p-6">
			<div class="flex items-center justify-between mb-8">
				<h1 class="text-2xl font-semibold">Book</h1>
				<a href="/books/new" class="btn btn-primary">New Book</a>
			</div>
			<div class="bg-white rounded-lg shadow">
				<div class="p-6">
					<p>List of books will be displayed here</p>
				</div>
			</div>
		</div>
	}
}

templ (r Book) Show() {
	@layouts.Base() {
		<div class="container mx-auto p-6">
			<div class="flex items-center justify-between mb-8">
				<h1 class="text-2xl font-semibold">Book Details</h1>
				<div class="flex gap-2">
					<a href="/books/edit" class="btn btn-outline">Edit</a>
					<a href="/books" class="btn btn-ghost">Back to List</a>
				</div>
			</div>
			<div class="bg-white rounded-lg shadow">
				<div class="p-6">
					<p>Book details will be displayed here</p>
				</div>
			</div>
		</div>
	}
}

templ (r Book) New() {
	@layouts.Base() {
		<div class="container mx-auto p-6">
			<div class="flex items-center justify-between mb-8">
				<h1 class="text-2xl font-semibold">New Book</h1>
				<a href="/books" class="btn btn-ghost">Back to List</a>
			</div>
			<div class="bg-white rounded-lg shadow">
				<div class="p-6">
					<form method="POST" action="/books">
						<div class="mb-4">
							<label class="block text-sm font-medium text-gray-700 mb-2">
								Name
							</label>
							<input type="text" name="name" class="input input-bordered w-full" required/>
						</div>
						<div class="flex justify-end gap-2">
							<a href="/books" class="btn btn-ghost">Cancel</a>
							<button type="submit" class="btn btn-primary">Create Book</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	}
}

templ (r Book) Edit() {
	@layouts.Base() {
		<div class="container mx-auto p-6">
			<div class="flex items-center justify-between mb-8">
				<h1 class="text-2xl font-semibold">Edit Book</h1>
				<a href="/books" class="btn btn-ghost">Back to List</a>
			</div>
			<div class="bg-white rounded-lg shadow">
				<div class="p-6">
					<form method="POST" action="/books">
						<input type="hidden" name="_method" value="PUT"/>
						<div class="mb-4">
							<label class="block text-sm font-medium text-gray-700 mb-2">
								Name
							</label>
							<input type="text" name="name" class="input input-bordered w-full" required/>
						</div>
						<div class="flex justify-end gap-2">
							<a href="/books" class="btn btn-ghost">Cancel</a>
							<button type="submit" class="btn btn-primary">Update Book</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	}
}

