package components

import (
	"github.com/mbvlabs/grafto/config"
	"github.com/mbvlabs/grafto/routes/paths"
	"github.com/mbvlabs/grafto/routes/contexts"
)

templ NavItem(name string, p paths.Path, attrs templ.Attributes) {
	<a
		{ attrs... }
		data-navItemPath={ p.Name }
		class="font-medium text-gray-300 hover:text-gray-500 focus:outline-none focus:ring-1 focus:ring-gray-600"
		href={ paths.GSP(ctx, p) }
	>{ name }</a>
}

templ Nav() {
	<header id="navigation" class="bsc">
		<div class="navbar flex justify-between">
			<div class="flex-1">
				<a class="btn btn-ghost text-xl" href={ paths.GSP(ctx, paths.LandingPage) }>{ config.Cfg.ProjectName }</a>
			</div>
			<div class="md:flex-none md:block hidden">
				<ul class="menu menu-horizontal px-1">
					<li>
						@NavItem("Home", paths.LandingPage, nil)
					</li>
					<li>
						@NavItem("About", paths.About, nil)
					</li>
					<li>
						if contexts.ExtractApp(ctx).IsAuthenticated {
							@NavItem("Logout", paths.DestroyAuthenticatedSession, nil)
						} else {
							@NavItem("Login", paths.CreateAuthenticatedSession, nil)
						}
					</li>
				</ul>
			</div>
			<div class="drawer flex-none w-fit md:hidden">
				<input id="mobile-drawer-nav" type="checkbox" class="drawer-toggle"/>
				<label for="mobile-drawer-nav" aria-label="open sidebar" class="btn btn-square btn-ghost">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						fill="none"
						viewBox="0 0 24 24"
						class="inline-block h-6 w-6 stroke-current"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M4 6h16M4 12h16M4 18h16"
						></path>
					</svg>
				</label>
				<div class="drawer-side">
					<label for="mobile-drawer-nav" aria-label="close sidebar" class="drawer-overlay"></label>
					<ul class="menu bg-base-200 min-h-full w-80 p-4">
						<li>
							@NavItem("Home", paths.LandingPage, nil)
						</li>
						<li>
							@NavItem("About", paths.About, nil)
						</li>
						<li>
							if contexts.ExtractApp(ctx).IsAuthenticated {
								@NavItem("Logout", paths.DestroyAuthenticatedSession, nil)
							} else {
								@NavItem("Login", paths.CreateAuthenticatedSession, nil)
							}
						</li>
					</ul>
				</div>
			</div>
		</div>
	</header>
}
