package components

type linkProps struct {
	Size    string
	Variant string
	Outline bool
	Target  string
}

type linkBuilder struct {
	text  string
	href  string
	props linkProps
}

func Link(text, href string) *linkBuilder {
	return &linkBuilder{
		text: text,
		href: href,
		props: linkProps{
			Size:    "medium",
			Variant: "default",
		},
	}
}

func (l *linkBuilder) WithSize(size string) *linkBuilder {
	l.props.Size = size
	return l
}

func (l *linkBuilder) WithTarget(target string) *linkBuilder {
	l.props.Target = target
	return l
}

func (l *linkBuilder) WithPrimary() *linkBuilder {
	l.props.Variant = "primary"
	return l
}

func (l *linkBuilder) WithSecondary() *linkBuilder {
	l.props.Variant = "secondary"
	return l
}

func (l *linkBuilder) WithSuccess() *linkBuilder {
	l.props.Variant = "success"
	return l
}

func (l *linkBuilder) WithInfo() *linkBuilder {
	l.props.Variant = "info"
	return l
}

func (l *linkBuilder) WithWarning() *linkBuilder {
	l.props.Variant = "warning"
	return l
}

func (l *linkBuilder) WithDanger() *linkBuilder {
	l.props.Variant = "danger"
	return l
}

func (l *linkBuilder) WithError() *linkBuilder {
	l.props.Variant = "error"
	return l
}

func (l *linkBuilder) WithGhost() *linkBuilder {
	l.props.Variant = "ghost"
	return l
}

func (l *linkBuilder) WithOutline() *linkBuilder {
	l.props.Outline = true
	return l
}

func (l *linkBuilder) WithDefault() *linkBuilder {
	l.props.Variant = "default"
	return l
}

func (l *linkBuilder) Build() templ.Component {
	return linkComponent(l.text, l.href, l.props)
}

templ linkComponent(text, href string, props linkProps) {
	<a
		href={ templ.URL(href) }
		if props.Target != "" {
			target={ props.Target }
		}
		class={
			"inline-flex items-center font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2",
			templ.KV("text-sm", props.Size == "small"),
			templ.KV("text-base", props.Size == "medium" || props.Size == ""),
			templ.KV("text-lg", props.Size == "large"),
			templ.KV("text-base-content hover:text-base-content/80 focus:ring-black hover:underline", (props.Variant == "default" || props.Variant == "") && !props.Outline),
			templ.KV("text-primary hover:text-primary/80 focus:ring-primary hover:underline", props.Variant == "primary" && !props.Outline),
			templ.KV("text-secondary hover:text-secondary/80 focus:ring-secondary hover:underline", props.Variant == "secondary" && !props.Outline),
			templ.KV("text-success hover:text-success/80 focus:ring-success hover:underline", props.Variant == "success" && !props.Outline),
			templ.KV("text-info hover:text-info/80 focus:ring-info hover:underline", props.Variant == "info" && !props.Outline),
			templ.KV("text-warning hover:text-warning/80 focus:ring-warning hover:underline", props.Variant == "warning" && !props.Outline),
			templ.KV("text-error hover:text-error/80 focus:ring-error hover:underline", (props.Variant == "danger" || props.Variant == "error") && !props.Outline),
			templ.KV("text-base-content hover:text-base-content/80 focus:ring-base-300 hover:underline", props.Variant == "ghost" && !props.Outline),
			templ.KV("border-2 px-2 py-1 rounded-md text-base-content border-black hover:bg-black hover:text-white hover:no-underline", (props.Variant == "default" || props.Variant == "") && props.Outline),
			templ.KV("border-2 px-2 py-1 rounded-md text-primary border-primary hover:bg-primary hover:text-primary-content hover:no-underline", props.Variant == "primary" && props.Outline),
			templ.KV("border-2 px-2 py-1 rounded-md text-secondary border-secondary hover:bg-secondary hover:text-secondary-content hover:no-underline", props.Variant == "secondary" && props.Outline),
			templ.KV("border-2 px-2 py-1 rounded-md text-success border-success hover:bg-success hover:text-success-content hover:no-underline", props.Variant == "success" && props.Outline),
			templ.KV("border-2 px-2 py-1 rounded-md text-info border-info hover:bg-info hover:text-info-content hover:no-underline", props.Variant == "info" && props.Outline),
			templ.KV("border-2 px-2 py-1 rounded-md text-warning border-warning hover:bg-warning hover:text-warning-content hover:no-underline", props.Variant == "warning" && props.Outline),
			templ.KV("border-2 px-2 py-1 rounded-md text-error border-error hover:bg-error hover:text-error-content hover:no-underline", (props.Variant == "danger" || props.Variant == "error") && props.Outline),
		}
	>
		{ text }
	</a>
}

templ PrimaryLink(text, href string) {
	@linkComponent(text, href, linkProps{Variant: "primary"})
}

templ SecondaryLink(text, href string) {
	@linkComponent(text, href, linkProps{Variant: "secondary"})
}

templ SuccessLink(text, href string) {
	@linkComponent(text, href, linkProps{Variant: "success"})
}

templ DangerLink(text, href string) {
	@linkComponent(text, href, linkProps{Variant: "danger"})
}

templ GhostLink(text, href string) {
	@linkComponent(text, href, linkProps{Variant: "ghost"})
}

templ OutlineLink(text, href string) {
	@linkComponent(text, href, linkProps{Variant: "default", Outline: true})
}

templ ExternalLink(text, href string) {
	@linkComponent(text, href, linkProps{Variant: "primary", Target: "_blank"})
}
