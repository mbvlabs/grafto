package components

type linkProps struct {
	Size    string
	Variant string
	Outline bool
	Target  string
}

type linkBuilder struct {
	text  string
	href  string
	props linkProps
}

func Link(text, href string) *linkBuilder {
	return &linkBuilder{
		text: text,
		href: href,
		props: linkProps{
			Size:    "medium",
			Variant: "default",
		},
	}
}

func (l *linkBuilder) WithSize(size string) *linkBuilder {
	l.props.Size = size
	return l
}

func (l *linkBuilder) WithTarget(target string) *linkBuilder {
	l.props.Target = target
	return l
}

func (l *linkBuilder) WithPrimary() *linkBuilder {
	l.props.Variant = "primary"
	return l
}

func (l *linkBuilder) WithSecondary() *linkBuilder {
	l.props.Variant = "secondary"
	return l
}

func (l *linkBuilder) WithSuccess() *linkBuilder {
	l.props.Variant = "success"
	return l
}

func (l *linkBuilder) WithInfo() *linkBuilder {
	l.props.Variant = "info"
	return l
}

func (l *linkBuilder) WithWarning() *linkBuilder {
	l.props.Variant = "warning"
	return l
}

func (l *linkBuilder) WithDanger() *linkBuilder {
	l.props.Variant = "danger"
	return l
}

func (l *linkBuilder) WithError() *linkBuilder {
	l.props.Variant = "error"
	return l
}

func (l *linkBuilder) WithGhost() *linkBuilder {
	l.props.Variant = "ghost"
	return l
}

func (l *linkBuilder) WithOutline() *linkBuilder {
	l.props.Outline = true
	return l
}

func (l *linkBuilder) Build() templ.Component {
	return linkComponent(l.text, l.href, l.props)
}

templ linkComponent(text, href string, props linkProps) {
	<a
		href={ templ.URL(href) }
		if props.Target != "" {
			target={ props.Target }
		}
		class={
			"link",
			templ.KV("link-sm", props.Size == "small"),
			templ.KV("link-md", props.Size == "medium" || props.Size == ""),
			templ.KV("link-lg", props.Size == "large"),
			templ.KV("link-default", props.Variant == "default" || props.Variant == ""),
			templ.KV("link-primary", props.Variant == "primary"),
			templ.KV("link-secondary", props.Variant == "secondary"),
			templ.KV("link-success", props.Variant == "success"),
			templ.KV("link-info", props.Variant == "info"),
			templ.KV("link-warning", props.Variant == "warning"),
			templ.KV("link-error", props.Variant == "danger" || props.Variant == "error"),
			templ.KV("link-ghost", props.Variant == "ghost"),
			templ.KV("link-outline", props.Outline),
		}
	>
		{ text }
	</a>
}

templ PrimaryLink(text, href string) {
	@linkComponent(text, href, linkProps{Variant: "primary"})
}

templ SecondaryLink(text, href string) {
	@linkComponent(text, href, linkProps{Variant: "secondary"})
}

templ SuccessLink(text, href string) {
	@linkComponent(text, href, linkProps{Variant: "success"})
}

templ DangerLink(text, href string) {
	@linkComponent(text, href, linkProps{Variant: "danger"})
}

templ GhostLink(text, href string) {
	@linkComponent(text, href, linkProps{Variant: "ghost"})
}

templ OutlineLink(text, href string) {
	@linkComponent(text, href, linkProps{Variant: "default", Outline: true})
}

templ ExternalLink(text, href string) {
	@linkComponent(text, href, linkProps{Variant: "primary", Target: "_blank"})
}

