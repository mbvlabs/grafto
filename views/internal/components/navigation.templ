package components

import (
	"github.com/mbvlabs/grafto/config"
	"github.com/mbvlabs/grafto/routes/paths"
	"github.com/mbvlabs/grafto/routes/contexts"
)

templ NavItem(name string, p paths.Path, attrs templ.Attributes) {
	<a
		{ attrs... }
		data-navItemPath={ p.Name }
		href={ paths.GSP(ctx, p) }
	>{ name }</a>
}

templ Nav() {
	<nav id="navigation" class="nav">
		<div class="container">
			<div class="nav-content">
				<div class="nav-logo">
					<a href={ paths.GSP(ctx, paths.LandingPage) }>{ config.Cfg.ProjectName }</a>
				</div>
				<button class="nav-toggle" aria-label="toggle navigation">
					<span class="hamburger"></span>
				</button>
				<div class="nav-menu">
					<ul class="menu">
						<li>
							@NavItem("Home", paths.LandingPage, nil)
						</li>
						<li>
							@NavItem("About", paths.About, nil)
						</li>
						<li>
							if contexts.ExtractApp(ctx).IsAuthenticated {
								@NavItem("Logout", paths.DestroyAuthenticatedSession, nil)
							} else {
								@NavItem("Login", paths.CreateAuthenticatedSession, nil)
							}
						</li>
					</ul>
				</div>
			</div>
		</div>
	</nav>
	<script>
		const navToggle = document.querySelector('.nav-toggle');
		const navMenu = document.querySelector('.nav-menu');
		
		navToggle.addEventListener('click', () => {
			navMenu.classList.toggle('nav-menu-active');
			navToggle.classList.toggle('nav-toggle-active');
		});
	</script>
}

