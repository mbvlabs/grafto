package components

import "fmt"
import "net/url"
import "strconv"

type Pagination struct {
	CurrentPage     int
	TotalPages      int
	TotalItems      int
	ItemsPerPage    int
	BaseURL         string
	QueryParams     url.Values
	ShowFirstLast   bool
	ShowPrevNext    bool
	ShowPageNumbers bool
	ShowPageInfo    bool
	ShowPageSize    bool
	MaxPageNumbers  int
	PageSizeOptions []int
	Size            string // small, medium, large
	Compact         bool
	Class           string
	Attributes      templ.Attributes
}

type SimplePagination struct {
	CurrentPage  int
	TotalPages   int
	BaseURL      string
	QueryParams  url.Values
	PrevText     string
	NextText     string
	ShowNumbers  bool
	Compact      bool
	Class        string
}

type PaginationInfo struct {
	CurrentPage  int
	ItemsPerPage int
	TotalItems   int
	StartItem    int
	EndItem      int
	Class        string
}

type PageSizeSelector struct {
	CurrentSize int
	Options     []int
	BaseURL     string
	QueryParams url.Values
	Class       string
}

templ (p Pagination) Build() {
	<div class={ "flex flex-col sm:flex-row items-center justify-between gap-4", p.Class } { p.Attributes... }>
		if p.ShowPageInfo {
			@p.buildPageInfo()
		}
		<div class="flex items-center gap-2">
			@p.buildNavigation()
		</div>
		if p.ShowPageSize {
			@p.buildPageSizeSelector()
		}
	</div>
}

templ (p Pagination) buildPageInfo() {
	<div class="text-sm text-base-content/70">
		{ p.getPageInfoText() }
	</div>
}

templ (p Pagination) buildNavigation() {
	<nav class="flex items-center gap-1" aria-label="Pagination">
		if p.ShowFirstLast && p.CurrentPage > 1 {
			<a
				href={ templ.SafeURL(p.buildURL(1)) }
				class={ p.getButtonClass(false, false) }
				aria-label="Go to first page"
			>
				if p.Compact {
					«
				} else {
					<span class="hidden sm:inline">First</span>
					<span class="sm:hidden">«</span>
				}
			</a>
		}
		
		if p.ShowPrevNext && p.CurrentPage > 1 {
			<a
				href={ templ.SafeURL(p.buildURL(p.CurrentPage - 1)) }
				class={ p.getButtonClass(false, false) }
				aria-label="Go to previous page"
			>
				if p.Compact {
					‹
				} else {
					<span class="hidden sm:inline">Previous</span>
					<span class="sm:hidden">‹</span>
				}
			</a>
		}
		
		if p.ShowPageNumbers {
			@p.buildPageNumbers()
		}
		
		if p.ShowPrevNext && p.CurrentPage < p.TotalPages {
			<a
				href={ templ.SafeURL(p.buildURL(p.CurrentPage + 1)) }
				class={ p.getButtonClass(false, false) }
				aria-label="Go to next page"
			>
				if p.Compact {
					›
				} else {
					<span class="hidden sm:inline">Next</span>
					<span class="sm:hidden">›</span>
				}
			</a>
		}
		
		if p.ShowFirstLast && p.CurrentPage < p.TotalPages {
			<a
				href={ templ.SafeURL(p.buildURL(p.TotalPages)) }
				class={ p.getButtonClass(false, false) }
				aria-label="Go to last page"
			>
				if p.Compact {
					»
				} else {
					<span class="hidden sm:inline">Last</span>
					<span class="sm:hidden">»</span>
				}
			</a>
		}
	</nav>
}

templ (p Pagination) buildPageNumbers() {
	for _, pageNum := range p.getVisiblePages() {
		if pageNum == -1 {
			<span class={ p.getEllipsisClass() }>…</span>
		} else {
			if pageNum == p.CurrentPage {
				<span
					class={ p.getButtonClass(true, false) }
					aria-current="page"
					aria-label={ fmt.Sprintf("Current page, page %d", pageNum) }
				>
					{ strconv.Itoa(pageNum) }
				</span>
			} else {
				<a
					href={ templ.SafeURL(p.buildURL(pageNum)) }
					class={ p.getButtonClass(false, false) }
					aria-label={ fmt.Sprintf("Go to page %d", pageNum) }
				>
					{ strconv.Itoa(pageNum) }
				</a>
			}
		}
	}
}

templ (p Pagination) buildPageSizeSelector() {
	<div class="flex items-center gap-2 text-sm">
		<span class="text-base-content/70 hidden sm:inline">Show:</span>
		<select 
			class="select select-bordered select-sm w-20"
			onchange="window.location.href = this.dataset.baseUrl + '&per_page=' + this.value"
			data-base-url={ p.buildURL(1) }
		>
			for _, size := range p.getPageSizeOptions() {
				<option value={ strconv.Itoa(size) } selected?={ size == p.ItemsPerPage }>
					{ strconv.Itoa(size) }
				</option>
			}
		</select>
		<span class="text-base-content/70 hidden sm:inline">per page</span>
	</div>
}

templ (sp SimplePagination) Build() {
	<div class={ "flex items-center justify-center gap-2", sp.Class }>
		if sp.CurrentPage > 1 {
			<a
				href={ templ.SafeURL(sp.buildURL(sp.CurrentPage - 1)) }
				class="btn btn-outline btn-sm"
			>
				{ sp.getPrevText() }
			</a>
		}
		
		if sp.ShowNumbers {
			<span class="text-sm text-base-content/70">
				Page { strconv.Itoa(sp.CurrentPage) } of { strconv.Itoa(sp.TotalPages) }
			</span>
		}
		
		if sp.CurrentPage < sp.TotalPages {
			<a
				href={ templ.SafeURL(sp.buildURL(sp.CurrentPage + 1)) }
				class="btn btn-outline btn-sm"
			>
				{ sp.getNextText() }
			</a>
		}
	</div>
}

templ (pi PaginationInfo) Build() {
	<div class={ "text-sm text-base-content/70", pi.Class }>
		Showing { strconv.Itoa(pi.StartItem) } to { strconv.Itoa(pi.EndItem) } of { strconv.Itoa(pi.TotalItems) } entries
	</div>
}

templ (ps PageSizeSelector) Build() {
	<div class={ "flex items-center gap-2 text-sm", ps.Class }>
		<span class="text-base-content/70">Show:</span>
		<select 
			class="select select-bordered select-sm w-20"
			onchange="window.location.href = this.dataset.baseUrl + '&per_page=' + this.value"
			data-base-url={ ps.buildBaseURL() }
		>
			for _, size := range ps.Options {
				<option value={ strconv.Itoa(size) } selected?={ size == ps.CurrentSize }>
					{ strconv.Itoa(size) }
				</option>
			}
		</select>
		<span class="text-base-content/70">per page</span>
	</div>
}

func (p Pagination) buildURL(page int) string {
	params := url.Values{}
	if p.QueryParams != nil {
		params = p.QueryParams
	}
	params.Set("page", strconv.Itoa(page))
	if p.ItemsPerPage > 0 {
		params.Set("per_page", strconv.Itoa(p.ItemsPerPage))
	}
	
	if p.BaseURL == "" {
		return "?" + params.Encode()
	}
	return p.BaseURL + "?" + params.Encode()
}

func (sp SimplePagination) buildURL(page int) string {
	params := url.Values{}
	if sp.QueryParams != nil {
		params = sp.QueryParams
	}
	params.Set("page", strconv.Itoa(page))
	
	if sp.BaseURL == "" {
		return "?" + params.Encode()
	}
	return sp.BaseURL + "?" + params.Encode()
}

func (ps PageSizeSelector) buildBaseURL() string {
	params := url.Values{}
	if ps.QueryParams != nil {
		params = ps.QueryParams
	}
	params.Set("page", "1")
	
	if ps.BaseURL == "" {
		return "?"
	}
	return ps.BaseURL + "?" + params.Encode()
}

func (p Pagination) getButtonClass(isCurrent, isDisabled bool) string {
	baseClass := "btn btn-sm"
	
	if p.Size == "large" {
		baseClass = "btn btn-md"
	} else if p.Size == "small" {
		baseClass = "btn btn-xs"
	}
	
	if isCurrent {
		return baseClass + " btn-primary"
	}
	
	if isDisabled {
		return baseClass + " btn-disabled"
	}
	
	return baseClass + " btn-outline"
}

func (p Pagination) getEllipsisClass() string {
	baseClass := "flex items-center justify-center text-base-content/50"
	
	if p.Size == "large" {
		return baseClass + " w-10 h-10"
	} else if p.Size == "small" {
		return baseClass + " w-6 h-6 text-xs"
	}
	
	return baseClass + " w-8 h-8 text-sm"
}

func (p Pagination) getVisiblePages() []int {
	if p.TotalPages <= 1 {
		return []int{}
	}
	
	maxNumbers := p.MaxPageNumbers
	if maxNumbers <= 0 {
		maxNumbers = 5
	}
	
	pages := []int{}
	
	if p.TotalPages <= maxNumbers {
		for i := 1; i <= p.TotalPages; i++ {
			pages = append(pages, i)
		}
		return pages
	}
	
	leftSide := maxNumbers / 2
	rightSide := maxNumbers - leftSide - 1
	
	if p.CurrentPage <= leftSide+1 {
		for i := 1; i <= maxNumbers-1; i++ {
			pages = append(pages, i)
		}
		pages = append(pages, -1)
		pages = append(pages, p.TotalPages)
	} else if p.CurrentPage >= p.TotalPages-rightSide {
		pages = append(pages, 1)
		pages = append(pages, -1)
		for i := p.TotalPages-maxNumbers+2; i <= p.TotalPages; i++ {
			pages = append(pages, i)
		}
	} else {
		pages = append(pages, 1)
		pages = append(pages, -1)
		for i := p.CurrentPage - leftSide + 1; i <= p.CurrentPage + rightSide - 1; i++ {
			pages = append(pages, i)
		}
		pages = append(pages, -1)
		pages = append(pages, p.TotalPages)
	}
	
	return pages
}

func (p Pagination) getPageInfoText() string {
	if p.TotalItems == 0 {
		return "No entries found"
	}
	
	startItem := (p.CurrentPage-1)*p.ItemsPerPage + 1
	endItem := p.CurrentPage * p.ItemsPerPage
	if endItem > p.TotalItems {
		endItem = p.TotalItems
	}
	
	return fmt.Sprintf("Showing %d to %d of %d entries", startItem, endItem, p.TotalItems)
}

func (p Pagination) getPageSizeOptions() []int {
	if len(p.PageSizeOptions) > 0 {
		return p.PageSizeOptions
	}
	return []int{10, 25, 50, 100}
}

func (sp SimplePagination) getPrevText() string {
	if sp.PrevText != "" {
		return sp.PrevText
	}
	if sp.Compact {
		return "‹"
	}
	return "Previous"
}

func (sp SimplePagination) getNextText() string {
	if sp.NextText != "" {
		return sp.NextText
	}
	if sp.Compact {
		return "›"
	}
	return "Next"
}

func NewPagination(currentPage, totalPages, totalItems, itemsPerPage int, baseURL string) Pagination {
	return Pagination{
		CurrentPage:     currentPage,
		TotalPages:      totalPages,
		TotalItems:      totalItems,
		ItemsPerPage:    itemsPerPage,
		BaseURL:         baseURL,
		ShowFirstLast:   true,
		ShowPrevNext:    true,
		ShowPageNumbers: true,
		ShowPageInfo:    true,
		ShowPageSize:    true,
		MaxPageNumbers:  5,
		PageSizeOptions: []int{10, 25, 50, 100},
		Size:            "medium",
	}
}

func NewSimplePagination(currentPage, totalPages int, baseURL string) SimplePagination {
	return SimplePagination{
		CurrentPage: currentPage,
		TotalPages:  totalPages,
		BaseURL:     baseURL,
		ShowNumbers: true,
	}
}

func NewPaginationInfo(currentPage, itemsPerPage, totalItems int) PaginationInfo {
	startItem := (currentPage-1)*itemsPerPage + 1
	endItem := currentPage * itemsPerPage
	if endItem > totalItems {
		endItem = totalItems
	}
	
	return PaginationInfo{
		CurrentPage:  currentPage,
		ItemsPerPage: itemsPerPage,
		TotalItems:   totalItems,
		StartItem:    startItem,
		EndItem:      endItem,
	}
}

func NewPageSizeSelector(currentSize int, options []int, baseURL string) PageSizeSelector {
	if len(options) == 0 {
		options = []int{10, 25, 50, 100}
	}
	
	return PageSizeSelector{
		CurrentSize: currentSize,
		Options:     options,
		BaseURL:     baseURL,
	}
}