package components

type ButtonProps struct {
	Size     string
	Variant  string
	Outline  bool
	Loading  bool
	Disabled bool
	Circle   bool
	Square   bool
}

type ButtonBuilder struct {
	text       string
	attributes templ.Attributes
	props      ButtonProps
}

func Button(text string) *ButtonBuilder {
	return &ButtonBuilder{
		text:       text,
		attributes: templ.Attributes{},
		props: ButtonProps{
			Size:    "medium",
			Variant: "default",
		},
	}
}

func (b *ButtonBuilder) WithSize(size string) *ButtonBuilder {
	b.props.Size = size
	return b
}

func (b *ButtonBuilder) WithVariant(variant string) *ButtonBuilder {
	b.props.Variant = variant
	return b
}

func (b *ButtonBuilder) WithOutline() *ButtonBuilder {
	b.props.Outline = true
	return b
}

func (b *ButtonBuilder) WithLoading() *ButtonBuilder {
	b.props.Loading = true
	return b
}

func (b *ButtonBuilder) WithDisabled() *ButtonBuilder {
	b.props.Disabled = true
	return b
}

func (b *ButtonBuilder) WithCircle() *ButtonBuilder {
	b.props.Circle = true
	return b
}

func (b *ButtonBuilder) WithSquare() *ButtonBuilder {
	b.props.Square = true
	return b
}

func (b *ButtonBuilder) WithAttributes(attrs templ.Attributes) *ButtonBuilder {
	for k, v := range attrs {
		b.attributes[k] = v
	}
	return b
}

func (b *ButtonBuilder) Build() templ.Component {
	return ButtonComponent(b.text, b.attributes, b.props)
}

templ ButtonComponent(text string, attributes templ.Attributes, props ButtonProps) {
	<button
		{ attributes... }
		class={ 
			"btn",
			templ.KV("btn-sm", props.Size == "small"),
			templ.KV("btn-md", props.Size == "medium" || props.Size == ""),
			templ.KV("btn-lg", props.Size == "large"),
			templ.KV("btn-default", props.Variant == "default" || props.Variant == ""),
			templ.KV("btn-primary", props.Variant == "primary"),
			templ.KV("btn-secondary", props.Variant == "secondary"),
			templ.KV("btn-success", props.Variant == "success"),
			templ.KV("btn-info", props.Variant == "info"),
			templ.KV("btn-warning", props.Variant == "warning"),
			templ.KV("btn-error", props.Variant == "danger" || props.Variant == "error"),
			templ.KV("btn-ghost", props.Variant == "ghost"),
			templ.KV("btn-outline", props.Outline),
			templ.KV("btn-loading", props.Loading),
			templ.KV("btn-circle", props.Circle),
			templ.KV("btn-square", props.Square),
		}
		disabled?={ props.Disabled || props.Loading }
	>
		{ text }
	</button>
}

templ PrimaryButton(text string, attributes templ.Attributes) {
	@ButtonComponent(text, attributes, ButtonProps{Variant: "primary"})
}

templ SecondaryButton(text string, attributes templ.Attributes) {
	@ButtonComponent(text, attributes, ButtonProps{Variant: "secondary"})
}

templ SuccessButton(text string, attributes templ.Attributes) {
	@ButtonComponent(text, attributes, ButtonProps{Variant: "success"})
}

templ DangerButton(text string, attributes templ.Attributes) {
	@ButtonComponent(text, attributes, ButtonProps{Variant: "danger"})
}

templ GhostButton(text string, attributes templ.Attributes) {
	@ButtonComponent(text, attributes, ButtonProps{Variant: "ghost"})
}

templ OutlineButton(text string, attributes templ.Attributes) {
	@ButtonComponent(text, attributes, ButtonProps{Variant: "default", Outline: true})
}

templ LoadingButton(text string, attributes templ.Attributes) {
	@ButtonComponent(text, attributes, ButtonProps{Variant: "default", Loading: true})
}

templ IconButton(attributes templ.Attributes) {
	<button
		{ attributes... }
		class={ 
			"btn",
			"btn-ghost",
			"btn-circle",
		}
	>
		{ children... }
	</button>
}

templ IconButtonSquare(attributes templ.Attributes) {
	<button
		{ attributes... }
		class={ 
			"btn",
			"btn-ghost",
			"btn-square",
		}
	>
		{ children... }
	</button>
}