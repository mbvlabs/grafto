package dashboard

import (
	"fmt"
	"time"

	"github.com/mbvlabs/grafto/models"
	"github.com/mbvlabs/grafto/views/internal/components"
	"github.com/mbvlabs/grafto/views/internal/layouts"
)

templ EditUser(user models.User) {
	@layouts.Dashboard() {
		<div class="space-y-6">
			<div class="flex items-center gap-4 bg-base-200 p-4 rounded-lg border border-base-300">
				<a 
					href="/dashboard/users" 
					class="btn btn-outline btn-sm border-2 hover:bg-primary hover:text-primary-content hover:border-primary"
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
					</svg>
					Back to Users
				</a>
				<h1 class="text-2xl font-bold text-base-content">Edit User</h1>
			</div>
			
			<div class="grid gap-6 lg:grid-cols-3">
				<div class="lg:col-span-2">
					@buildUserEditForm(user)
				</div>
				<div>
					@buildUserInfoCard(user)
				</div>
			</div>
		</div>
	}
}

templ buildUserEditForm(user models.User) {
	<div class="bg-base-100 rounded-lg shadow-lg border-2 border-base-300 p-6">
		<h2 class="text-lg font-semibold text-base-content mb-4 pb-2 border-b border-base-300">User Details</h2>
		
		@components.Form(components.FormProps{
			Attributes: templ.Attributes{
				"method": "POST",
				"action": fmt.Sprintf("/dashboard/users/%s", user.ID.String()),
			},
		}) {
			<div class="grid gap-4">
				@components.Input{
					Type: "email",
					Name: "email",
					ID: "email",
					Label: "Email Address",
					Value: user.Email,
					Required: true,
					Help: "The user's email address for login and notifications",
				}.Build()
				
				@components.Checkbox{
					Name: "is_admin",
					ID: "is_admin",
					Text: "Administrator privileges",
					Value: "true",
					Checked: user.IsAdmin,
				}.Build()
				<p class="text-sm text-base-content/60">Grant administrative access to this user</p>
				
				<div class="flex gap-3 pt-4 border-t border-base-300 mt-4">
					@components.Button("Save Changes").WithPrimary().WithType("submit").Build()
					<a href="/dashboard/users" class="btn btn-outline border-2 hover:bg-secondary hover:text-secondary-content hover:border-secondary">Cancel</a>
				</div>
			</div>
		}
	</div>
}

templ buildUserInfoCard(user models.User) {
	<div class="bg-base-100 rounded-lg shadow-lg border-2 border-base-300 p-6">
		<h2 class="text-lg font-semibold text-base-content mb-4 pb-2 border-b border-base-300">User Information</h2>
		
		<div class="space-y-4">
			<div>
				<dt class="text-sm font-medium text-base-content/70">User ID</dt>
				<dd class="text-sm text-base-content font-mono">{ user.ID.String() }</dd>
			</div>
			
			<div>
				<dt class="text-sm font-medium text-base-content/70">Created</dt>
				<dd class="text-sm text-base-content">{ formatDetailDate(user.CreatedAt) }</dd>
			</div>
			
			<div>
				<dt class="text-sm font-medium text-base-content/70">Last Updated</dt>
				<dd class="text-sm text-base-content">{ formatDetailDate(user.UpdatedAt) }</dd>
			</div>
			
			<div>
				<dt class="text-sm font-medium text-base-content/70">Email Verification</dt>
				<dd class="text-sm">
					if user.IsVerified() {
						<span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-success/20 text-success">
							✓ Verified
						</span>
						<div class="text-xs text-base-content/60 mt-1">
							{ formatDetailDate(user.EmailVerifiedAt) }
						</div>
					} else {
						<span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-warning/20 text-warning">
							⚠ Not Verified
						</span>
					}
				</dd>
			</div>
			
			<div>
				<dt class="text-sm font-medium text-base-content/70">Role</dt>
				<dd class="text-sm">
					if user.IsAdmin {
						<span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-primary/20 text-primary">
							👑 Administrator
						</span>
					} else {
						<span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-secondary/20 text-secondary">
							👤 User
						</span>
					}
				</dd>
			</div>
		</div>
		
		<div class="border-t border-base-300 mt-6 pt-6 space-y-3">
			<h3 class="text-sm font-medium text-base-content/70">Quick Actions</h3>
			
			<div class="flex flex-col gap-2">
				<form 
					method="POST" 
					action={ templ.SafeURL(fmt.Sprintf("/dashboard/users/%s/toggle-admin", user.ID.String())) }
					onsubmit="return confirm('Are you sure you want to change this user\\'s admin status?')"
				>
					@components.Button(getToggleAdminButtonText(user.IsAdmin)).WithOutline().WithType("submit").Build()
				</form>
				
				@components.Button("Reset Password").WithWarning().WithOutline().Build()
				
				<form 
					method="POST" 
					action={ templ.SafeURL(fmt.Sprintf("/dashboard/users/%s/delete", user.ID.String())) }
					onsubmit="return confirm('Are you sure you want to delete this user? This action cannot be undone.')"
				>
					@components.Button("Delete User").WithDanger().WithOutline().WithType("submit").Build()
				</form>
			</div>
		</div>
	</div>
}

func formatDetailDate(t time.Time) string {
	if t.IsZero() {
		return "Never"
	}
	return t.Format("January 2, 2006 at 3:04 PM")
}

func getToggleAdminButtonText(isAdmin bool) string {
	if isAdmin {
		return "Remove Admin Access"
	}
	return "Grant Admin Access"
}