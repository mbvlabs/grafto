package sessions

import (
	"github.com/mbvlabs/grafto/router/routes"
	"github.com/mbvlabs/grafto/views"
	"github.com/mbvlabs/grafto/views/internal/components"
	"github.com/mbvlabs/grafto/views/internal/layouts"
)

type ResetPasswordFormProps struct {
	PasswordError        string
	ConfirmPasswordError string
	CsrfToken            string
	ResetToken           string
	Errors               views.Errors
}

templ ResetPasswordForm(props ResetPasswordFormProps) {
	@components.Form(components.FormProps{
		Class: "rounded-lg p-4 bg-base-200 flex flex-col items-center w-full",
		Attributes: templ.Attributes{
			"hx-post":   routes.StoreResetPasswordPage.Path,
			"hx-target": "this",
			"hx-swap":   "outerHTML",
		},
	}) {
		<input type="hidden" name="gorilla.csrf.Token" value={ props.CsrfToken }/>
		<input type="hidden" name="token" value={ props.ResetToken }/>
		<div class="text-center w-full">
			<h1 class="block text-2xl font-bold text-white">Reset Password</h1>
		</div>
		<div class="mt-5 w-full">
			@components.Input{
				ID:          "password",
				Label:       "Password",
				Name:        "password",
				Type:        "password",
				Placeholder: "Enter your password",
				Required:    true,
				Error:       props.PasswordError,
				Attributes:  templ.Attributes{"minlength": "8"},
			}.Build()
			@components.Input{
				ID:          "confirm_password",
				Label:       "Confirm Password",
				Name:        "confirm_password",
				Type:        "password",
				Placeholder: "Repeat your password",
				Required:    true,
				Error:       props.ConfirmPasswordError,
				Attributes:  templ.Attributes{"minlength": "8"},
			}.Build()
			@components.Button("Reset Password").WithInfo().WithOutline().WithType("submit").Build()
		</div>
	}
}

templ ResetPasswordTokenInvalid() {
	<div role="alert" class="mb-4 alert alert-info col-span-4 md:col-start-2 md:col-end-6 lg:col-span-4 lg:col-start-5 shadow-xl">
		<svg
			xmlns="http://www.w3.org/2000/svg"
			class="h-6 w-6 shrink-0 stroke-current"
			fill="none"
			viewBox="0 0 24 24"
		>
			<path
				stroke-linecap="round"
				stroke-linejoin="round"
				stroke-width="2"
				d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
			></path>
		</svg>
		<span>Your token is no longer valid; Please request a new one.</span>
	</div>
}

templ ResetPasswordPage(invalidToken, internalErr bool, csrfToken, resetToken string) {
	@layouts.Base(
		views.WithTitle("Reset Password"),
	) {
		<main class="container mx-auto my-auto grid grid-cols-4 px-4 md:grid-cols-6 lg:grid-cols-12">
			<div
				class="flex flex-col items-center col-span-4 md:col-start-2 md:col-end-6 lg:col-span-4 lg:col-start-5 shadow-xl"
			>
				if invalidToken {
					//@formFlagWrapper() {
					//	@components.InfoFlag("Your token is no longer valid; Please request a new one.")
					//}
				}
				if internalErr {
					//@formFlagWrapper() {
					//	@components.ErrorFlag("An error occured we could not recover from.")
					//}
				}
				@ResetPasswordForm(ResetPasswordFormProps{
					CsrfToken:  csrfToken,
					ResetToken: resetToken,
				})
			</div>
		</main>
	}
}
