package views

import (
	"github.com/mbvlabs/grafto/views/internal/layouts"
)

templ NotFoundPage() {
	@layouts.Base() {
		<main class="flex-1 w-full px-4 flex flex-col justify-center items-center">
			<h1 class="text-2xl font-bold">404 - Page Not Found</h1>
			<p class="max-w-[768px] mx-auto text-center">
				The page you are looking for does not exist. It might have been moved, deleted, or you entered the wrong URL.
			</p>
			<div class="flex justify-center">
				<a
					href="/"
					class="mt-2 text-primary flex items-center"
				>
					Go back to home
				</a>
			</div>
		</main>
	}
}